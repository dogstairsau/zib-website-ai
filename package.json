{
  "name": "zib-homepage",
  "version": "0.1.0",
  "private": true,
  "description": "Zib Digital homepage + AI audit endpoint",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --experimental-strip-types --test 'lib/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=.env.local dev-server.mjs",
    "dev:vercel": "vercel dev",
    "deploy": "vercel deploy --prod",
    "hubspot:properties": "node scripts/hubspot-properties.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@vercel/edge": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vercel": "^33.0.0"
  }
}
