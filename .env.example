# Required — Anthropic key for the strategist read
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required for sample creative — OpenAI key (gpt-image-1-mini by default)
OPENAI_API_KEY=sk-proj-...

# Optional — override defaults (gpt-image-1-mini · 1024x1536 · medium)
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=high

# Optional — without it, PSI is rate-limited
PSI_API_KEY=

# Optional — without it, leads log to the function console only
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional — for posting lead notifications to Slack
SLACK_WEBHOOK_URL=

# ────────────────────────────────────────────────────────────────────
# Lead notification via Resend (https://resend.com)
# Without all 3 set, audit submissions log to console but no email is sent.
# ────────────────────────────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sender address. Use onboarding@resend.dev to test without verifying a domain,
# but for production verify a domain at https://resend.com/domains.
LEAD_NOTIFY_FROM=audits@zibdigital.com.au
# Where audit notifications land
LEAD_NOTIFY_EMAIL=michael.glasser@zibdigital.com.au

# ────────────────────────────────────────────────────────────────────
# Proposal engagement alerts (/api/proposal-view)
# Where "Sarah opened the proposal" emails land. Optional — falls back to
# LEAD_NOTIFY_EMAIL. Set it separately if proposal alerts should go to the
# salesperson while audit leads keep going somewhere else.
# Recipients and their ?k= tokens live in lib/proposalRecipients.ts.
# ────────────────────────────────────────────────────────────────────
# PROPOSAL_NOTIFY_EMAIL=

# ────────────────────────────────────────────────────────────────────
# Redis key-value store — used by the rate limiter, the benchmark cache
# and proposal view counts.
#
# Vercel KV no longer exists: Vercel retired it and migrated existing
# stores to Upstash Redis in Dec 2024. There is no "KV" option in the
# dashboard any more, so don't go looking for one.
#
# Enable: Vercel dashboard → Storage → Marketplace Database Providers →
# Upstash → Redis → connect to this project, then redeploy.
#   https://vercel.com/docs/redis
#   https://vercel.com/marketplace/upstash
#
# The Upstash integration injects the two vars below automatically —
# still named KV_* for compatibility with the old Vercel KV, which is why
# the code reads those names. You don't paste them manually.
#
# Without them everything fails open: no rate limiting on /api/audit and
# /api/blog, and proposal alerts still email but can't count views, so
# every session reports as a first open.
# ────────────────────────────────────────────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
