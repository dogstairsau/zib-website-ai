# Required — Anthropic key for the strategist read
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required for sample creative — OpenAI key (gpt-image-1-mini by default)
OPENAI_API_KEY=sk-proj-...

# Optional — override defaults (gpt-image-1-mini · 1024x1536 · medium)
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=high

# Optional — without it, PSI is rate-limited
PSI_API_KEY=

# Optional — Google Places API key (Places API enabled) for the Brand Score
# reviews signal. Without it, the reviews signal is skipped (score degrades
# gracefully). News (GDELT), Reddit and Google Trends signals need no key.
GOOGLE_PLACES_API_KEY=

# Optional — without it, leads log to the function console only
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional — for posting lead notifications to Slack
SLACK_WEBHOOK_URL=

# ────────────────────────────────────────────────────────────────────
# Lead notification via Resend (https://resend.com)
# Without all 3 set, audit submissions log to console but no email is sent.
# ────────────────────────────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sender address. Use onboarding@resend.dev to test without verifying a domain,
# but for production verify a domain at https://resend.com/domains.
LEAD_NOTIFY_FROM=audits@zibdigital.com.au
# Where audit notifications land
LEAD_NOTIFY_EMAIL=michael.glasser@zibdigital.com.au

# ────────────────────────────────────────────────────────────────────
# Rate limiting via Vercel KV (https://vercel.com/storage/kv)
# Without these, /api/audit and /api/blog have no rate limit (fail open).
# Enable: Vercel dashboard → Storage → Create → KV → connect to project.
# Vercel will auto-inject these env vars; you don't paste them manually.
# ────────────────────────────────────────────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
