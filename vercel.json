{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/audit.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?ziboutreach\\.com\\.au" }],
      "destination": "/audit",
      "permanent": false
    },
    {
      "source": "/:path((?!audit$|audit\\.html$|chelsea-teelow$|chelsea-teelow\\.html$|marty-tucker$|marty-tucker\\.html$|daniel-harris$|daniel-harris\\.html$|brad-reece$|brad-reece\\.html$|corrine-chalmers$|corrine-chalmers\\.html$|matt-arnot$|matt-arnot\\.html$|dylan-and-jake$|dylan-and-jake\\.html$|roi-calculator$|roi-calculator\\.html$|sandra$|sandra\\.html$|api/|assets/|robots\\.txt$|favicon\\.ico$).+)",
      "has": [{ "type": "host", "value": "(www\\.)?ziboutreach\\.com\\.au" }],
      "destination": "https://zibdigital.com.au/:path",
      "permanent": false
    }
  ]
}
