{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/audit.ts": {
      "maxDuration": 60
    },
    "api/prompt-research.ts": {
      "maxDuration": 30
    },
    "api/meta-ads-lab.ts": {
      "maxDuration": 90
    }
  },
  "redirects": [
    { "source": "/dylan-jake", "destination": "/dylan-and-jake", "permanent": true },
    { "source": "/new-final-home-page", "destination": "/", "permanent": true },
    { "source": "/team/matt-jackson", "destination": "/meet-the-team", "permanent": true },
    { "source": "/team/brandon-wood", "destination": "/meet-the-team", "permanent": true },
    { "source": "/contact-zibdigital", "destination": "/audit", "permanent": true },
    { "source": "/get-in-touch", "destination": "/audit", "permanent": true },
    { "source": "/zib-partner-opportunity", "destination": "/partner", "permanent": true },
    { "source": "/category/:slug*", "destination": "/blog", "permanent": true },
    { "source": "/casestudy-category/:slug*", "destination": "/case-studies", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?ziboutreach\\.com\\.au" }],
      "destination": "/audit",
      "permanent": false
    },
    {
      "source": "/:path((?!audit$|audit\\.html$|meta-ads-lab$|meta-ads-lab\\.html$|chelsea-teelow$|chelsea-teelow\\.html$|marty-tucker$|marty-tucker\\.html$|daniel-harris$|daniel-harris\\.html$|brad-reece$|brad-reece\\.html$|corrine-chalmers$|corrine-chalmers\\.html$|matt-arnot$|matt-arnot\\.html$|dylan-and-jake$|dylan-and-jake\\.html$|roi-calculator$|roi-calculator\\.html$|sandra$|sandra\\.html$|prompt-research$|prompt-research\\.html$|australian-infinity-hospitality-solutions$|australian-infinity-hospitality-solutions\\.html$|archer-scott-lawyers$|archer-scott-lawyers\\.html$|alchemy-construct$|alchemy-construct\\.html$|Mad-Mex-SEO-GEO-Opportunity$|Mad-Mex-SEO-GEO-Opportunity\\.html$|api/|assets/|robots\\.txt$|llms\\.txt$|sitemap\\.xml$|favicon\\.ico$).+)",
      "has": [{ "type": "host", "value": "(www\\.)?ziboutreach\\.com\\.au" }],
      "destination": "https://zibdigital.com.au/:path",
      "permanent": false
    }
  ]
}
