{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build.mjs && node migration/sitemap.mjs && cp sitemap.xml dist/sitemap.xml",
  "outputDirectory": "dist",
  "functions": {
    "api/audit.ts": {
      "maxDuration": 60
    },
    "api/prompt-research.ts": {
      "maxDuration": 30
    },
    "api/meta-ads-lab.ts": {
      "maxDuration": 300
    },
    "api/google-ads-lab.ts": {
      "maxDuration": 300
    },
    "api/growth-benchmarks.ts": {
      "maxDuration": 30
    },
    "api/start.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/case-study", "destination": "/case-studies", "permanent": true },
    { "source": "/casestudy", "destination": "/case-studies", "permanent": true },
    { "source": "/our-portfolio", "destination": "/case-studies", "permanent": true },
    { "source": "/web-design", "destination": "/web-graphic-design-melbourne", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/team/marty-tucker", "destination": "/marty-tucker", "permanent": true },
    { "source": "/team/paul-harrison", "destination": "/meet-the-team", "permanent": true },
    { "source": "/marketing-strategies-2021", "destination": "/blog", "permanent": true },
    { "source": "/marketing-trends-2022", "destination": "/blog", "permanent": true },
    { "source": "/aaron-jason", "destination": "/contact", "permanent": true },
    { "source": "/ange-ethan", "destination": "/contact", "permanent": true },
    { "source": "/ben-kelly", "destination": "/contact", "permanent": true },
    { "source": "/mvfc-digital-healthcheck", "destination": "/audit", "permanent": true },
    { "source": "/search-contacts", "destination": "/", "permanent": true },
    { "source": "/test-form", "destination": "/", "permanent": true },
    { "source": "/test-short-code", "destination": "/", "permanent": true },
    { "source": "/dylan-jake", "destination": "/dylan-and-jake", "permanent": true },
    { "source": "/new-final-home-page", "destination": "/", "permanent": true },
    { "source": "/team/matt-jackson", "destination": "/meet-the-team", "permanent": true },
    { "source": "/team/brandon-wood", "destination": "/meet-the-team", "permanent": true },
    { "source": "/contact-zibdigital", "destination": "/contact", "permanent": true },
    { "source": "/get-in-touch", "destination": "/contact", "permanent": true },
    { "source": "/zib-partner-opportunity", "destination": "/partner", "permanent": true },
    { "source": "/refer", "destination": "/submit-a-referral", "permanent": true },
    { "source": "/referral", "destination": "/submit-a-referral", "permanent": true },
    { "source": "/referrals", "destination": "/submit-a-referral", "permanent": true },
    { "source": "/submit-referral", "destination": "/submit-a-referral", "permanent": true },
    { "source": "/partner-opportunity", "destination": "/partner", "permanent": true },
    { "source": "/email-marketing-melbourne", "destination": "/email-marketing", "permanent": true },
    { "source": "/local-seo-melbourne", "destination": "/seo-melbourne", "permanent": true },
    { "source": "/web-graphic-designers", "destination": "/web-graphic-design-melbourne", "permanent": true },
    { "source": "/design-branding", "destination": "/web-graphic-design-melbourne", "permanent": true },
    { "source": "/team", "destination": "/meet-the-team", "permanent": true },
    { "source": "/wp-content/uploads/2022/02/ZibDigital_WhitePaper_2022-1.pdf", "destination": "/blog", "permanent": true },
    { "source": "/google-ads-old", "destination": "/google-ads-management-agency-melbourne", "permanent": true },
    { "source": "/social-media-marketing-old", "destination": "/social-media-marketing", "permanent": true },
    { "source": "/category/:slug*", "destination": "/blog", "permanent": true },
    { "source": "/casestudy-category/:slug*", "destination": "/case-studies", "permanent": true },
    { "source": "/team/:slug*", "destination": "/meet-the-team", "permanent": true },
    { "source": "/what-we-do/social-media", "destination": "/social-media-marketing", "permanent": true },
    { "source": "/what-we-do/content-marketing", "destination": "/content-marketing", "permanent": true },
    { "source": "/what-we-do/google-ads", "destination": "/google-ads", "permanent": true },
    { "source": "/what-we-do/design-branding", "destination": "/web-graphic-design-melbourne", "permanent": true },
    { "source": "/what-we-do/:slug*", "destination": "/digital-marketing-agency", "permanent": true },
    { "source": "/digital-strategy", "destination": "/digital-marketing-agency", "permanent": true },
    { "source": "/why-zib", "destination": "/why-zib-digital", "permanent": true },
    { "source": "/feed", "destination": "/blog", "permanent": true },
    { "source": "/feed/:path*", "destination": "/blog", "permanent": true },
    { "source": "/:slug/feed", "destination": "/:slug", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?ziboutreach\\.com\\.au" }],
      "destination": "https://zibdigital.com.au/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
